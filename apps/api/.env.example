# Application
ENVIRONMENT=development
DEBUG=True
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_bridge

# Redis
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
STORAGE_BUCKET_PUBLIC=public
STORAGE_BUCKET_PRIVATE=private

# Email Provider (RESEND or SENDGRID or NOT_CONFIGURED)
EMAIL_PROVIDER=NOT_CONFIGURED
EMAIL_FROM=noreply@businessbridge.com
RESEND_API_KEY=
SENDGRID_API_KEY=

# Payment Provider
PAYMENT_PROVIDER=NOT_CONFIGURED
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# AI (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Settings
DEFAULT_COMMISSION_RATE=0.05
MAX_FILE_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=*

# Feature Flags
ENABLE_VERIFICATION=True
ENABLE_MESSAGING=True
ENABLE_OFFERS=True
ENABLE_DOCUMENTS=True
ENABLE_NOTIFICATIONS=True
ENABLE_AI_FEATURES=True
ENABLE_DATA_ROOMS=True
ENABLE_DEAL_ROOMS=True
ENABLE_VALUATION=True
ENABLE_REVIEWS=True
ENABLE_AI_BROKER=True
