# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/business_bridge
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage
STORAGE_BUCKET_PUBLIC=public
STORAGE_BUCKET_PRIVATE=private

# Email Provider (Configuration required)
EMAIL_PROVIDER=NOT_CONFIGURED
# EMAIL_FROM=noreply@businessbridge.com
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# Payment Providers (Configuration required)
PAYMENT_PROVIDER=NOT_CONFIGURED
# Stripe (if using)
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Paystack (if using)
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=

# Commission Settings
DEFAULT_COMMISSION_RATE=0.05

# File Upload Limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,webp

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Environment
NODE_ENV=development

# Security
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost

# Feature Flags (V1 only)
ENABLE_VERIFICATION=true
ENABLE_MESSAGING=true
ENABLE_OFFERS=true
ENABLE_DOCUMENTS=true
ENABLE_NOTIFICATIONS=true

# Future Features (DO NOT ENABLE IN V1)
ENABLE_AI_FEATURES=false
ENABLE_DATA_ROOMS=false
ENABLE_DEAL_ROOMS=false
ENABLE_VALUATION=false
ENABLE_REVIEWS=false
ENABLE_AI_BROKER=false
