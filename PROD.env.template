# ============================================================
# BUSINESS BRIDGE - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# Instructions:
# 1. Copy this file to .env.production
# 2. Replace all placeholders (e.g., your-...) with real keys
# 3. Ensure this file is NEVER committed to version control
# ============================================================

# Environment Configuration
ENVIRONMENT=production
DEBUG=false
NODE_ENV=production

# Application URLs
# IMPORTANT: Update these to your live domain
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
API_URL=https://api.yourdomain.com

# Database (PostgreSQL)
# Use your production Supabase or AWS RDS connection string
DATABASE_URL=postgresql://user:password@your-prod-db-host:5432/postgres

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://:your-password@your-prod-redis-host:6379

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security & Authentication
# IMPORTANT: Generate a new random 64+ character string
JWT_SECRET=GENERATE_NEW_RANDOM_LONG_STRING_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage Buckets
# Ensure these are created in your Supabase dashboard
STORAGE_BUCKET_PUBLIC=public
STORAGE_BUCKET_PRIVATE=private

# Email Provider
# Recommended: Resend, SendGrid, or Postmark
EMAIL_PROVIDER=RESEND
EMAIL_FROM=deals@yourdomain.com
RESEND_API_KEY=re_your_api_key

# Payment Providers (REQUIRED for Transactions)
PAYMENT_PROVIDER=STRIPE
# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Paystack Configuration (Optional for Africa)
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_WEBHOOK_SECRET=...

# AI Broker & Intelligence
# REQUIRED for AI features
AI_PROVIDER=GOOGLE
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Business Logic Settings
DEFAULT_COMMISSION_RATE=0.05
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,webp
RATE_LIMIT_PER_MINUTE=60

# Security - CORS
# IMPORTANT: Limit this to your actual production domain
CORS_ORIGINS=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# Production Feature Flags
ENABLE_VERIFICATION=true
ENABLE_MESSAGING=true
ENABLE_OFFERS=true
ENABLE_DOCUMENTS=true
ENABLE_NOTIFICATIONS=true
ENABLE_AI_FEATURES=true
ENABLE_DATA_ROOMS=true
ENABLE_DEAL_ROOMS=true
ENABLE_VALUATION=true
ENABLE_REVIEWS=true
ENABLE_AI_BROKER=true
